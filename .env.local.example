# Abyss Video Hosting API Key
ABYSS_API_KEY=your_abyss_api_key_here

# Turso (libSQL) Edge Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudflare Worker Smart Stream Proxy (Optional, defaults to seiryu.stutosed.workers.dev)
NEXT_PUBLIC_STREAM_PROXY_URL=https://seiryu.stutosed.workers.dev

# Website Settings
NEXT_PUBLIC_SITE_URL=https://stutosed.7atva.workers.dev
